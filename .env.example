# ---- Backend (read from this file at the repo root) ----
PORT=3001
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage (relative paths are resolved from the repo root)
UPLOAD_DIR=uploads
RENDER_DIR=renders
TEMP_DIR=temp
# Uploaded audio and rendered videos are deleted after this many hours
FILE_TTL_HOURS=24
MAX_UPLOAD_MB=50
MAX_MEDIA_MINUTES=15

# External tools (defaults assume they are on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
# PYTHON_PATH=python3

# WhisperX (optional; improves timing and transcribes songs LRCLIB doesn't know)
WHISPERX_ENABLED=true
WHISPERX_MODEL_SIZE=base
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_TIMEOUT_MINUTES=20

# Rendering
RENDER_MAX_CONCURRENT=1
RENDER_TIMEOUT_MINUTES=30
# Frames rendered in parallel (default: half your CPU cores, max 8)
# REMOTION_CONCURRENCY=4
# Use an existing Chrome/Chromium instead of letting Remotion download one
# REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
# OpenGL backend for Chrome, e.g. angle or swangle
# REMOTION_GL=

# ---- Frontend (copy to frontend/.env.local if you change the backend URL) ----
NEXT_PUBLIC_API_URL=http://localhost:3001
